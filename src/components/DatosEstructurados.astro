---
import clinica from '../data/clinica.json';
import doctores from '../data/doctores.json';

// JSON-LD. Lo que un buscador lee para saber que esto es una clínica dental de
// Tegucigalpa con un horario concreto.
//
// TRES COSAS QUE NO ESTÁN AQUÍ, Y NO POR OLVIDO:
//
//   - aggregateRating y review. CIMO tiene CERO reseñas públicas (su Facebook
//     marca 0). Declarar una valoración que no existe es exactamente el tipo de
//     dato inventado que este proyecto no produce, y además es sancionable por
//     Google como marcado engañoso.
//   - geo. La dirección está sin confirmar tras la mudanza anunciada en mayo de
//     2026, así que no hay coordenadas: unas inventadas mandarían pacientes al
//     sitio equivocado.
//   - medicalSpecialty más allá de lo odontológico. El nombre dice "Médico
//     Odontológico" pero todo el contenido verificable es dental.

interface Props { url: string }
const { url } = Astro.props;

const sede = clinica.sedes[0];
const dias = {
  0: 'Sunday', 1: 'Monday', 2: 'Tuesday', 3: 'Wednesday',
  4: 'Thursday', 5: 'Friday', 6: 'Saturday',
} as const;

const horario = sede.horarios.map((t) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: t.dow.map((d) => dias[d as keyof typeof dias]),
  opens: t.apertura,
  closes: t.cierre,
}));

const datos = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: clinica.nombre,
  legalName: clinica.nombreCompleto,
  description: clinica.descripcion,
  url,
  telephone: clinica.telefono.href,
  email: clinica.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${sede.direccion.calle}, ${sede.direccion.edificio}, ${sede.direccion.detalle}`,
    addressLocality: sede.direccion.ciudad,
    postalCode: sede.direccion.codigoPostal,
    addressCountry: 'HN',
  },
  openingHoursSpecification: horario,
  sameAs: [clinica.redes.instagram, clinica.redes.facebook, clinica.redes.tiktok],
  availableService: [
    { '@type': 'MedicalProcedure', name: 'Ortodoncia invisible (Invisalign)' },
    { '@type': 'MedicalProcedure', name: 'Ortodoncia con brackets' },
    { '@type': 'MedicalProcedure', name: 'Higiene y prevención dental' },
    { '@type': 'MedicalProcedure', name: 'Odontopediatría' },
    { '@type': 'MedicalProcedure', name: 'Rehabilitación estética' },
  ],
  // EL PERSONAL, desde noviembre de 2026. Hasta entonces esto estaba vacío por
  // el mismo motivo que sigue vacío `review`: no constaba. Ahora la nómina la
  // da la clínica, los ocho salen con cara y nombre en la página, y lo que se
  // declara aquí es exactamente lo que se ve — que es la condición de Google
  // para el marcado y, antes que eso, la de este proyecto.
  //
  // `Person` y `jobTitle`, NO `Dentist` ni `Physician` con `medicalSpecialty`.
  // Es contraintuitivo y conviene dejarlo escrito: en schema.org, `Dentist` y
  // `Physician` son tipos de NEGOCIO —subtipos de MedicalBusiness—, no de
  // persona. Declarar `employee: [{'@type':'Dentist'}]` diría que esta clínica
  // emplea a ocho clínicas. Lo que emplea son ocho personas, y la especialidad
  // de una persona es su `jobTitle`.
  //
  // `image` en absoluto y no en relativo: el resto del sitio escribe las rutas
  // sin barra inicial para poder abrirse desde file://, pero un buscador no
  // resuelve una ruta relativa dentro de un JSON-LD contra la página.
  employee: doctores.map((d) => ({
    '@type': 'Person',
    name: d.nombre,
    jobTitle: d.especialidad,
    image: new URL(`img/${d.foto}.webp`, url).href,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(datos)} is:inline />
